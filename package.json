{
  "name": "dev-toolbox-agent-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"features/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" eslint.config.mjs playwright.config.ts prettier.config.mjs vitest.config.mts package.json",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"features/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" eslint.config.mjs playwright.config.ts prettier.config.mjs vitest.config.mts package.json",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:level-1": "playwright test --grep @level-1",
    "test:e2e:level-2": "playwright test --grep @level-2",
    "test:e2e:level-3": "playwright test --grep @level-3",
    "test:report": "node scripts/test-report.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "doctor": "node scripts/doctor.mjs",
    "doctor:offline": "node scripts/doctor.mjs --offline",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.55.0",
    "next": "^15.4.0",
    "node-sql-parser": "^5.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql-formatter": "^15.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
